{
  "name": "draftroom-workflow",
  "version": "1.0.0",
  "description": "Parallel YouTube scriptwriting on Render Workflows",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --import tsx src/main.ts",
