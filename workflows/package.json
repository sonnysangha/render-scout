    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@renderinc/sdk": "^0.5.0",
    "ai": "^7.0.66",
    "pg": "^8.16.0",
    "tsx": "^4.20.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.2",
    "typescript": "^5.9.3"
  }
}
